@id("read-research") permit (principal, action in [Jans::Action::"Search", Jans::Action::"Read"], resource) when { context has tokens && context.tokens has jans_access_token && context.tokens.jans_access_token.hasTag("scp") && context.tokens.jans_access_token.getTag("scp").contains("research:read") && context.tokens.jans_access_token.hasTag("aud") && context.tokens.jans_access_token.getTag("aud").contains("ledgerline-research") };